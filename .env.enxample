CLOUDFLARE_R2_ENDPOINT=https://1f2aa5ea2bc5e35b27a5a4bdeeb55a5d.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=climb-arquivos
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_REGION=auto
